{
  "name": "dwg-desk",
  "version": "1.3.1",
  "description": "Lokalna przegl\u0105darka DWG i DXF z pomiarem odleg\u0142o\u015bci dla macOS",
  "author": "DWG Desk",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node scripts/prepare.mjs && vite build",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.mjs",
    "test:electron": "node scripts/smoke.mjs",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "test:pan": "node scripts/test-pan.mjs",
    "test:design": "node scripts/design-smoke.mjs",
    "test:camera": "node scripts/camera-smoke.mjs",
    "test:export": "node scripts/export-smoke.mjs",
    "test:colors": "node scripts/color-smoke.mjs"
  },
  "build": {
    "appId": "local.dwgdesk.viewer",
    "productName": "DWG Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "asar": true,
    "mac": {
      "target": [
        "zip",
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "notarize": false,
      "icon": "build/icon.icns",
      "minimumSystemVersion": "13.0",
      "artifactName": "DWG-Desk-${version}-mac-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "dwg",
          "dxf"
        ],
        "name": "Rysunek CAD",
        "role": "Viewer"
      }
    ]
  },
  "dependencies": {
    "@flyfish-dev/cad-viewer": "0.8.3"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1",
    "vite": "8.3.4"
  }
}
